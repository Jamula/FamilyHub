{
  "name": "jamula-family-coordinator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "dev": "wrangler dev",
    "deploy": "node scripts/deploy.mjs",
    "assets": "node scripts/build-assets.mjs",
    "build": "npm run assets && wrangler deploy --dry-run --outdir build",
    "ci": "node scripts/ci.mjs",
    "migrate:production": "wrangler d1 migrations apply jamula-family-coordinator --remote",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**/*.js\" --test-coverage-include=\"public/**/*.js\" --test-coverage-include=\"scripts/**/*.mjs\" --test-coverage-exclude=\"src/assets.js\" --test-coverage-exclude=\"src/build-version.js\" --test-coverage-exclude=\"public/vendor/**\""
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "jose": "6.2.13"
  },
  "devDependencies": {
    "html2canvas": "1.4.1",
    "wrangler": "4.156.0"
  },
  "engines": {
    "node": ">=26.12.1 <27"
  }
}
